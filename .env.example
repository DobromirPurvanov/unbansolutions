# Server-only variables configured in Vercel. Never prefix secrets with VITE_.
RESEND_API_KEY=
CONTACT_EMAIL=support@unbansolutions.com
FROM_EMAIL=Unban Solutions <noreply@unbansolutions.com>
SITE_URL=https://www.unbansolutions.com
RATE_LIMIT_SALT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public analytics identifiers. Scripts still load only after consent.
VITE_GA_MEASUREMENT_ID=G-FD6BFR3X5T
VITE_META_PIXEL_ID=1330505575908646

# ─── Cloudflare Turnstile (bot protection on the contact form) ───
# REQUIRED. Without it the form accepts everything and every submission
# logs a warning in the Vercel logs.
# Cloudflare → Turnstile → widget "unbansolutions.com kontaktna forma" → Secret key.
# The site key is public and lives in src/lib/turnstile.ts.
TURNSTILE_SECRET_KEY=

# true = a missing token also blocks. Defaults to false, because the token is
# also missing for real visitors running an ad blocker.
TURNSTILE_REQUIRE_TOKEN=false
